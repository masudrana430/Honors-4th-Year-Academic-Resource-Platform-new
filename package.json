{
  "name": "honors-4th-year-academic-resource-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Public Honors 4th Year Academic Resource Platform with Next.js App Router, TypeScript, Tailwind CSS, PostgreSQL, Prisma, Google Drive API, Gemini AI Assistant, and Voice Search",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "drive:sync": "tsx scripts/sync-google-drive.ts",
    "render:build": "npm install && npx prisma generate && npx prisma migrate deploy && npm run db:seed && npm run build",
    "db:update-classical-titles": "tsx scripts/update-classical-electrodynamics-titles.ts",
    "db:update-statistical-mechanics-titles": "tsx scripts/update-statistical-mechanics-titles.ts",
    "db:update-electronics-2-titles": "tsx scripts/update-electronics-2-titles.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "katex": "^0.19.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
