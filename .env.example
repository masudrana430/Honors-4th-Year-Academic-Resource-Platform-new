# PostgreSQL Connection (Local or Render PostgreSQL Internal/External URL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/honors_db"

# Google Gemini API Key (Server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Google Drive Service Account Configuration (Server-side only)
GOOGLE_DRIVE_FOLDER_ID="YOUR_DRIVE_FOLDER_ID"
GOOGLE_DRIVE_CLIENT_EMAIL="YOUR_SERVICE_ACCOUNT_EMAIL"
GOOGLE_DRIVE_PRIVATE_KEY="YOUR_SERVICE_ACCOUNT_PRIVATE_KEY"

# Admin upload protection (use a long, random secret; never expose it with NEXT_PUBLIC_)\nADMIN_UPLOAD_TOKEN="REPLACE_WITH_A_LONG_RANDOM_SECRET"\n\n# Optional: Google Cloud Speech-to-Text Server Fallback (if enabled alongside Browser Web Speech API)
GOOGLE_SPEECH_TO_TEXT_ENABLED="false"

# Public Site Metadata URL (Update with your Render URL in production)
NEXT_PUBLIC_APP_URL="https://honors-4th-year-academic-resource-platform.onrender.com"
