# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/honors_db"

# Gemini (server-side only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Google Drive OAuth for a personal Gmail account (server-side only)
# Create an OAuth 2.0 Web application client in Google Cloud Console.
GOOGLE_DRIVE_CLIENT_ID="YOUR_OAUTH_CLIENT_ID"
GOOGLE_DRIVE_CLIENT_SECRET="YOUR_OAUTH_CLIENT_SECRET"
# Must exactly match the callback URI registered in Google Cloud Console:
GOOGLE_DRIVE_REDIRECT_URI="https://YOUR_DOMAIN/api/google-drive/oauth/callback"
# Generate once through /api/google-drive/oauth/start?key=YOUR_SETUP_SECRET
GOOGLE_DRIVE_OAUTH_SETUP_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
# Obtain from the OAuth callback response and add to Vercel; never commit a real token.
GOOGLE_DRIVE_REFRESH_TOKEN="YOUR_REFRESH_TOKEN"

# Optional browser speech fallback
GOOGLE_SPEECH_TO_TEXT_ENABLED="false"
NEXT_PUBLIC_APP_URL="https://YOUR_DOMAIN"


# Google Cloud Text-to-Speech (server-side only; never expose this in NEXT_PUBLIC_* variables)
# Enable the Cloud Text-to-Speech API and billing in the same Google Cloud project.
# Create a service account with permission to use that project/API. Paste the complete JSON as
# a single-line JSON string into this environment variable in Vercel/local .env.
GOOGLE_CLOUD_TTS_SERVICE_ACCOUNT_JSON='PASTE_MINIFIED_SERVICE_ACCOUNT_JSON_HERE'
